// Полная программа: FizzBuzz
fn fizzbuzz() {
    for (int i = 1; i <= 20; i += 1) {
        if (i % 3 == 0 && i % 5 == 0) {
            // fizzbuzz
            int x = 0;
        } else {
            if (i % 3 == 0) {
                int y = 1;
            } else {
                if (i % 5 == 0) {
                    int z = 2;
                }
            }
        }
    }
}
