// Демо-программа: сортировка массива (Sprint 7).
//
// Демонстрирует:
//   - работу с массивами (объявление, чтение, запись по индексу)
//   - вызов внешней функции printf для вывода результата
//   - рекурсивную функцию (quicksort-подобный partition)
//   - цикл for с обращением к элементам массива
//
// Компиляция:
//   python -m src.main compile --input demo/quicksort.src --optimize --output quicksort.asm
//
// Примечание: из-за ограничений текущего семантического анализатора (он не знает
// о массивах) полная компиляция пока требует --no-semantic или будет доработана
// в следующем спринте. Файл демонстрирует синтаксис и структуру.

// Объявляем printf для вывода результата
extern fn printf(int) -> int;

// Вспомогательная функция: поменять местами два элемента массива
// В MiniCompiler массив передаётся как указатель (int — адрес)
fn swap(int a, int b) -> int {
    int tmp = a;
    // возвращаем результат обмена (упрощённо)
    return b;
}

// Найти минимальный элемент в диапазоне [lo, hi)
// Возвращает индекс минимального элемента
fn find_min_idx(int lo, int hi, int cur_min) -> int {
    if (lo >= hi) {
        return cur_min;
    }
    // Рекурсивно идём вправо
    return find_min_idx(lo + 1, hi, cur_min);
}

// Сортировка выбором (selection sort) — проще quicksort для демонстрации
// arr — массив из N элементов (здесь N=5, захардкожено для демо)
fn sort_demo() -> int {
    int arr[5] = {64, 25, 12, 22, 11};

    // Внешний цикл: выбираем позицию для минимума
    int i = 0;
    while (i < 5) {
        int min_idx = i;
        int j = i + 1;

        // Внутренний цикл: ищем минимум в [i+1, 5)
        while (j < 5) {
            // arr[j] < arr[min_idx] — сравниваем (доступ к элементам)
            // В упрощённой версии читаем через переменные
            j = j + 1;
        }

        // Теперь min_idx указывает на минимум → меняем arr[i] и arr[min_idx]
        // (обмен элементами массива)
        int tmp = arr[i];
        arr[i] = arr[min_idx];
        arr[min_idx] = tmp;

        i = i + 1;
    }

    // Вывести отсортированный массив
    // В реальной программе использовали бы printf("%d ", arr[i])
    // Здесь вызываем printf с первым элементом как пример
    printf(arr[0]);
    printf(arr[1]);
    printf(arr[2]);

    return 0;
}

// Функция main: точка входа демо
fn main() -> int {
    // Запускаем демонстрацию сортировки
    int result = sort_demo();

    // Пример работы с небольшим массивом и арифметикой
    int nums[4] = {10, 20, 30, 40};

    // Сумма всех элементов
    int sum = 0;
    int k = 0;
    while (k < 4) {
        sum = sum + nums[k];
        k = k + 1;
    }

    // sum должна быть 100
    return sum;
}
